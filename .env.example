# 環境変数のサンプルファイルです。
# 実際の値は絶対にコミットしないでください。
# 使用する際はこのファイルを `.env` としてコピーし、値を設定してください(`.env` は .gitignore 対象です)。
#
# 以下のうちSupabase関連の2つは、AIによる条件解釈(Edge Function ai-route-planning)で
# 実際に使用しています。それ以外は将来の機能追加に備えて名前のみを定義しており、
# 現時点では未使用・未連携です(docs/ARCHITECTURE.md 参照)。

# --- 地図・ルート検索 (将来導入予定, 現時点では未使用) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- バックエンド (Expoアプリから使用中) ---
# publishable keyは公開前提のキーのため、Expoアプリから使って構いません。
# ただし実際の値はこのファイルではなく .env に置き、コミットしないでください。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI API (Supabase Edge Function側のみで使用。Expoアプリには絶対に含めない) ---
# OPENAI_API_KEY / SUPABASE_SERVICE_ROLE_KEY / UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN / RATE_LIMIT_HASH_SECRET は、Supabaseの
# Edge Function Secretsとしてのみ設定し、このアプリの.envには追加しないこと。
