# 環境変数のサンプルファイルです。
# 実際の値は絶対にコミットしないでください。
# 使用する際はこのファイルを `.env` としてコピーし、値を設定してください(`.env` は .gitignore 対象です)。
#
# 以下のキーは、将来の機能追加に備えて名前のみを定義しています。
# 現時点ではこれらの外部APIは未使用・未連携です(docs/ARCHITECTURE.md 参照)。

# --- 地図・ルート検索 (将来導入予定, 現時点では未使用) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- バックエンド / 認証 (将来導入予定, 現時点では未使用) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI API (将来導入予定, 現時点では未使用) ---
ANTHROPIC_API_KEY=
